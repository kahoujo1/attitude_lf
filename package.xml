<?xml version="1.0"?>
<package format="2">

  <name>leader_follower_controller_plugin</name>
  <version>1.0.0</version>
  <description>The leader_follower_controller_plugin package</description>

  <author email="martin.jirousek@fel.cvut.cz">Martin Jirousek</author>
  <maintainer email="martin.jirousek@fel.cvut.cz">Martin Jirousek</maintainer>

  <license>BSD 3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>message_generation</build_depend>
  <exec_depend>message_generation</exec_depend>
  <build_depend>message_runtime</build_depend>
  <exec_depend>message_runtime</exec_depend>

  <build_depend>std_msgs</build_depend>
  <exec_depend>std_msgs</exec_depend>
  
  <depend>cmake_modules</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>pluginlib</depend>
  <depend>geometry_msgs</depend>
  <depend>dynamic_reconfigure</depend>
  <depend>mrs_uav_managers</depend>
  <depend>mrs_msgs</depend>
  <depend>mrs_lib</depend>

  <export>
    <mrs_uav_managers plugin="${prefix}/plugins.xml" />
